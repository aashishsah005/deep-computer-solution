# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/deep_computer_solution

# JWT
JWT_SECRET=supersecretkeyfordeepcomputersolution123!
JWT_EXPIRES_IN=7d

# Admin Owner Credentials
ADMIN_EMAIL=owner@deepcomputersolution.com
ADMIN_PASSWORD=admin123

# Cloudinary (free tier) for product images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# WhatsApp business number shown on site (with country code, no +)
SHOP_WHATSAPP_NUMBER=9779815392825

# ── Meta WhatsApp Cloud API (Official — Most Secure) ──────────────────────
# Setup: https://developers.facebook.com → Create App → Business → Add WhatsApp product
# Step 1: Get the Phone Number ID from your WhatsApp dashboard
META_WA_PHONE_ID=
# Step 2: Create a System User in Business Settings → generate permanent token
META_WA_TOKEN=

# ── Green API (Free alternative — scan QR once at green-api.com) ───────────
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=

# ── CallMeBot (Free alternative — message +34 644 65 31 16 to activate) ────
WHATSAPP_API_KEY=
